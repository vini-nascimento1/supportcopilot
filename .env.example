SUPABASE_URL=https://sarbmqumaadpozmpenyr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://sarbmqumaadpozmpenyr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
INTERCOM_ACCESS_TOKEN=
INTERCOM_ADMIN_ID=
INTERCOM_APP_ID=
# Google OAuth — same client_id/secret configured in Supabase Auth → Providers → Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Slack per-agent OAuth app
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Notion public OAuth integration
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Comma-separated list of manager emails who can see the Metrics tab
MANAGER_EMAILS=
# AI draft generation — the one Fanvue OpenAI key the whole app runs on. There
# is no per-agent key: every draft, every agent, one org key. Required — without
# it drafting returns 503.
OPENAI_API_KEY=
# Only set to point at an Azure / gateway OpenAI-compatible endpoint. Needs /v1.
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional model overrides. Luna is the default for both: it's multimodal (one
# model for text + screenshots) and the cheap tier. OPENAI_AUX_MODEL covers the
# narrow calls (draft verifier, screenshot evidence, playbook gate, keyword
# expansion) — point it at something cheaper to cut cost without touching reply
# quality.
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_AUX_MODEL=gpt-5.6-luna
# gpt-5.x replaced temperature with reasoning effort:
# none | low | medium | high | xhigh | max. Reasoning tokens are billed as output
# AND count against the completion budget, so raising this costs money and can
# starve the visible reply if the budget is tight.
OPENAI_REASONING_EFFORT=low

# Throttle (lib/ai-throttle.ts) — protects the org's rate limit when bulk
# drafting, the webhook pipeline and the queue backfill all fire at once. Every
# call in the app passes through it. Raise these once you know the real limits
# for the key from the OpenAI dashboard.
AI_MAX_CONCURRENCY=6
AI_MAX_PER_WINDOW=90
AI_WINDOW_MS=60000
